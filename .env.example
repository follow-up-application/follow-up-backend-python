# Clave secreta de Django (en producción usar una cadena larga y aleatoria)
DJANGO_SECRET_KEY=django-insecure-cambiar-por-un-valor-secreto-y-largo
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,reports

# Conexiones a PostgreSQL Local
# 1. DATABASE_URL: Solo lectura para datos académicos (alumnos, asistencias, notas)
DATABASE_URL=postgres://reports_reader:12345@localhost:5432/follow

# 2. JOBS_DATABASE_URL: Lectura y escritura en el esquema 'reportes' para los jobs y certificados
JOBS_DATABASE_URL=postgres://reports_writer:12345@localhost:5432/follow

# Cola de tareas Celery (Redis)
REDIS_URL=redis://localhost:6379/0

# Seguridad: Token compartido exclusivamente entre Node.js y Django
SERVICE_TOKEN=followup-secret-service-token-2026

# Almacenamiento temporal de PDFs y Excels
STORAGE_DIR=storage/documents
DOCUMENT_TTL_HOURS=72
MAX_ROWS=20000
TIME_ZONE=America/Argentina/Buenos_Aires
